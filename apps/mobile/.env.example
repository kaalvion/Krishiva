# Krishiva Mobile Environment Variables Template
# Copy this file to .env and fill in your values.

# Backend API URL (Use your PC's local LAN IP when running on physical phone via Expo Go)
# Example: http://192.168.1.9:3000 (do not use localhost on physical device)
EXPO_PUBLIC_API_URL=http://192.168.1.9:3000

# Firebase Client SDK Configuration (Found in Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/config)
