# ==============================================================================
# Krishiva Backend Environment Configuration Example
# Copy this file to .env and adjust variables as required
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
# Path to your Firebase service account JSON key (relative or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=../../secrets/firebase-admin.json

# EMQX MQTT Broker Configuration (TLS over port 8883)
EMQX_HOST=broker.emqx.io
EMQX_PORT=8883
EMQX_USERNAME=krishiva_user
EMQX_PASSWORD=krishiva_password
MQTT_CLIENT_ID_PREFIX=krishiva-backend

# CORS Configuration (comma-separated origins e.g. http://localhost:5173 or *)
CORS_ORIGINS=http://localhost:5173,*

# Firebase Web API Key (required for scripts/get-test-token.ts)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
