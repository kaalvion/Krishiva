rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all client access
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read/write only their own user document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Farms are readable only by members or the owner
    match /farms/{farmId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        resource.data.members[request.auth.uid] != null
      );
      allow write: if false; // Mutated only via server/admin SDK

      // Farm subcollections (devices, telemetry)
      match /{subcollection=**} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/farms/$(farmId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/farms/$(farmId)).data.members
        );
        allow write: if false; // Telemetry ingested strictly via backend MQTT service
      }
    }
  }
}
