rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global default: deny everything not allowed below
    // (Firestore ORs all matching rules, so the specific rules below still work.)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // The device user: the one Email/Password account every Krishiva master signs in with
    function isDevice() {
      return request.auth != null && request.auth.uid == "BYEr1eznePWgys4mVgX7SZRRknf2";
    }

    // Active member of the farm (costs one extra read per check)
    function isMember(farmId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }

    function memberRole(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data.role;
    }

    function isOwnerOrAdmin(farmId) {
      return isMember(farmId) && memberRole(farmId) in ['owner', 'admin'];
    }

    // A customer who claimed a device owns farms/<his uid>/... (no extra read needed)
    function isFarmOwner(farmId) {
      return isSignedIn() && request.auth.uid == farmId;
    }

    // ===============================================================
    // Factory registry (Krishiva masters): devices/<MAC>
    // ===============================================================
    match /devices/{mac} {
      // the master reads its own document; an owner reads his own device
      allow read: if isDevice() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // the master registers itself as INACTIVE with an EMPTY ownerUid
      allow create: if isDevice() && request.resource.data.ownerUid == "";

      // the master may update everything EXCEPT ownerUid
      allow update: if isDevice() && request.resource.data.ownerUid == resource.data.ownerUid;

      // a customer claims a device (QR scan): ONLY while ownerUid is still empty,
      // ONLY to his own uid, and nothing else may change. Once set, nobody can claim it again.
      allow update: if isSignedIn()
                    && resource.data.ownerUid == ""
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'CLAIMED_AT']);
    }

    // ===============================================================
    // User profile documents: /users/{uid}
    // ===============================================================
    match /users/{uid} {
      // Users can read and update their own user profile (name, phone, language, preferences)
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ===============================================================
    // Collection group queries: members
    // ===============================================================
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ===============================================================
    // Farms: /farms/{farmId}
    // ===============================================================
    match /farms/{farmId} {
      allow read: if isFarmOwner(farmId) || isMember(farmId);
      allow write: if false;

      match /members/{userId} {
        allow get: if (isFarmOwner(farmId) || isMember(farmId)) && (request.auth.uid == userId || isOwnerOrAdmin(farmId));
        allow list: if isFarmOwner(farmId) || isOwnerOrAdmin(farmId);
        allow write: if false;
      }

      // ---------------------------------------------------------------
      // Backend-managed devices (lowercase "devices"): read-only for members/owner
      // ---------------------------------------------------------------
      match /devices/{deviceId} {
        allow read: if isFarmOwner(farmId) || isMember(farmId);
        allow write: if false;

        match /latest/{docId} {
          allow read: if isFarmOwner(farmId) || isMember(farmId);
          allow write: if false;
        }

        match /{readingCollection}/{readingId} {
          allow read: if (isFarmOwner(farmId) || isMember(farmId)) && readingCollection.matches('^readings_[0-9_]+$');
          allow write: if false;
        }

        match /commands/{commandId} {
          allow read: if isFarmOwner(farmId) || isMember(farmId);
          allow write: if false;
        }
      }

      // ---------------------------------------------------------------
      // Krishiva masters (uppercase "DEVICES"): farms/<ownerUid>/DEVICES/<MAC>
      //   - the master (device user) reads and writes everything under its own device
      //   - the owner / members read everything
      //   - the owner / admins write ONLY MASTER/COMMANDS (relay commands, AUTO, SLAVE_MACS,
      //     SCHEDULES, ALERT_PHONE) and may acknowledge SIM_CHANGED
      // ---------------------------------------------------------------
      match /DEVICES/{mac} {
        allow read, write: if isDevice();
        allow read: if !isDevice() && (isFarmOwner(farmId) || isMember(farmId));
        allow update: if !isDevice()
                      && (isFarmOwner(farmId) || isOwnerOrAdmin(farmId))
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['SIM_CHANGED']);

        // MASTER/COMMANDS, SLAVE/NODEn, SLAVE_MAP/<mac>, SIM_HISTORY/<iccid>, ALERTS/<fire alert> ...
        match /{coll}/{docId} {
          allow read, write: if isDevice();
          allow read: if !isDevice() && (isFarmOwner(farmId) || isMember(farmId));
          allow write: if !isDevice()
                       && coll == 'MASTER' && docId == 'COMMANDS'
                       && (isFarmOwner(farmId) || isOwnerOrAdmin(farmId));
          allow update: if !isDevice()
                       && coll == 'ALERTS'
                       && (isFarmOwner(farmId) || isOwnerOrAdmin(farmId))
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt', 'acknowledgedBy']);
        }
      }

      // ---------------------------------------------------------------
      // Farm operational subcollections: alerts
      // ---------------------------------------------------------------
      match /alerts/{alertId} {
        allow read: if isFarmOwner(farmId) || isMember(farmId);
        // Alert acknowledgement from mobile app: allows updating acknowledgement fields
        allow update: if (isFarmOwner(farmId) || isOwnerOrAdmin(farmId))
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt', 'acknowledgedBy']);
        allow create, delete: if false;
      }

      match /schedules/{scheduleId} {
        allow read: if isFarmOwner(farmId) || isMember(farmId);
        allow write: if false;
      }

      match /schedule_runs/{runId} {
        allow read, write: if false;
      }

      // ---------------------------------------------------------------
      // Field boundary subcollection (plots & polygons)
      // ---------------------------------------------------------------
      match /fields/{fieldId} {
        allow read: if isFarmOwner(farmId) || isMember(farmId);
        allow create, update, delete: if isFarmOwner(farmId) || isOwnerOrAdmin(farmId);
      }

      // ---------------------------------------------------------------
      // Weather forecast and agrometeorology cache
      // ---------------------------------------------------------------
      match /weather/{docId} {
        allow read: if isFarmOwner(farmId) || isMember(farmId);
        allow write: if false;
      }

      // ---------------------------------------------------------------
      // AI intelligence: farm brief, water_report, yield_report, health score
      // ---------------------------------------------------------------
      match /ai/{docId} {
        allow read: if isFarmOwner(farmId) || isMember(farmId);
        allow write: if false;
      }
    }
  }
}
